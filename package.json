{
  "name": "lexiscene",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "description": "词境阅读 / LexiScene — 在真实语境中巩固用户词汇的英语阅读工具",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "worker:dev": "cd worker && npm run dev",
    "worker:dev:remote": "cd worker && npm run dev:remote",
    "worker:deploy": "cd worker && wrangler deploy"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.28.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "read-excel-file": "^9.3.5",
    "tesseract.js": "^6.0.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.45",
    "react-error-boundary": "^6.1.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^4.1.1"
  }
}
